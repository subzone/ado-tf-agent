{
  "manifestVersion": 1,
  "id": "ado-tf-agent",
  "version": "1.0.0",

  "name": "ADO Terraform Agent",
  "publisher": "subzone",
  "description": "Terraform pipeline task with multi-cloud backends plus an interactive build results tab with color-coded diffs, expandable attribute changes, dependency graph, policy warnings and PR comments.",
  "public": true,
  "categories": ["Azure Pipelines"],
  "tags": ["Terraform", "IaC", "Plan", "Visualization", "Azure", "AWS", "GCP", "Infrastructure", "DevOps"],
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "icons": {
    "default": "images/extension-icon.png"
  },
  "scopes": ["vso.build", "vso.build_execute", "vso.code_write"],
  "content": {
    "details": {
      "path": "overview.md"
    },
    "license": {
      "path": "PRIVACY.md"
    }
  },
  "links": {
    "getstarted": {
      "uri": "https://github.com/subzone/ado-tf-agent#readme"
    },
    "support": {
      "uri": "https://github.com/subzone/ado-tf-agent/issues"
    },
    "privacypolicy": {
      "uri": "https://github.com/subzone/ado-tf-agent/blob/main/PRIVACY.md"
    },
    "learn": {
      "uri": "https://github.com/subzone/ado-tf-agent/blob/main/overview.md"
    }
  },
  "repository": {
    "type": "git",
    "uri": "https://github.com/subzone/ado-tf-agent"
  },
  "files": [
    {
      "path": "images",
      "addressable": true
    },
    {
      "path": "tasks/Terraform",
      "addressable": false
    },
    {
      "path": "ui/dist",
      "addressable": true
    }
  ],
  "contributions": [
    {
      "id": "terraform-task",
      "type": "ms.vss-distributed-task.task",
      "targets": ["ms.vss-distributed-task.tasks"],
      "properties": {
        "name": "tasks/Terraform"
      }
    },
    {
      "id": "terraform-plan-tab",
      "type": "ms.vss-build-web.build-results-tab",
      "description": "Visual Terraform plan and diagram from published plan.json artifact.",
      "targets": ["ms.vss-build-web.build-results-view"],
      "properties": {
        "name": "Terraform",
        "uri": "ui/dist/planTab.html",
        "supportsTasks": ["b8f3a2c1-7d4e-4a9b-8f1c-3e5d7a9b2c4d"]
      }
    }
  ]
}
